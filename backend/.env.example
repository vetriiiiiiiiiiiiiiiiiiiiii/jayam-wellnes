# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Server
PORT=5005
NODE_ENV=development
BACKEND_URL=http://localhost:5005
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
STORE_NAME=Jayam Wellness

# PostgreSQL (local: `npm run db:start` prints these URLs)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Admin user created by `npm run db:seed` (defaults are for local development only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Auth — use long random strings
JWT_SECRET=change-me
SESSION_SECRET=change-me
SUPERADMIN_EMAILS=
DEFAULT_SUPERADMIN_EMAIL=

# Google sign-in ("Continue with Google"; hidden on the site while empty)
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorised JavaScript origin:  your FRONTEND_URL
#   Authorised redirect URI:       {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (sk_test_… / whsec_… while testing, live keys at launch)
# Webhook endpoint: {BACKEND_URL}/api/payments/stripe/webhook
#   events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
# Locally: `stripe listen --forward-to localhost:5005/api/payments/stripe/webhook` prints the whsec_ secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — Resend (https://resend.com). Verify your domain in Resend, then set MAIL_FROM on it.
# Until the domain is verified, Resend's onboarding@resend.dev only delivers to your own Resend inbox.
RESEND_API_KEY=
MAIL_FROM="Jayam Wellness <orders@your-domain.com>"
# Inbox that receives website enquiries (and receives replies to order emails)
SUPPORT_EMAIL=

# Optional SMTP fallback, used only when RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Image storage (optional MinIO; local disk when USE_MINIO=false)
USE_MINIO=false
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
