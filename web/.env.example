# Copy to web/.env.local and fill in. Never commit .env.local.

# Backend API
VITE_API_URL=http://localhost:5005

# Stripe publishable key (pk_test_… while testing)
VITE_STRIPE_PUBLISHABLE_KEY=

# Contact details shown on the site (leave empty to hide)
VITE_SUPPORT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM_URL=

# Legal name shown in the Privacy Policy and Terms (defaults to "Jayam Wellness")
VITE_LEGAL_NAME=
